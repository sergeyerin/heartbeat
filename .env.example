# === Telegram ===
# Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# === Language ===
# Used when the Telegram profile language is not ru/en and the user has not
# picked a language with /lang. One of: ru, en.
DEFAULT_LANG=en

# === Time ===
# Zone used to display times (everything is stored in UTC)
TZ=Europe/Moscow

# === Storage ===
# SQLite file. In Docker the data/ directory is mounted as a volume.
DB_PATH=data/heartbeat.db

# How often the card of an ongoing episode is redrawn, seconds. 0 = never.
# Once a minute is enough: seconds are noise in a diary and each redraw is an
# API call.
CARD_TICK_SEC=60
# How many hours a medication card keeps counting "taken N ago" before its
# tick stops. Longer than a day is pointless for "when is the next dose".
MED_TICK_MAX_H=24

# === Safeguards (public bot, single process) ===
# One person must not be able to degrade the service for everyone else.
MAX_EPISODES_PER_USER=5000
MAX_OPEN_EPISODES=10
MAX_MEDS_PER_USER=5000
MAX_LIVE_MED_CARDS=10
MIN_ACTION_INTERVAL_SEC=1.5
EXPORT_COOLDOWN_SEC=60

# === Episode timing ===
# Episode window, minutes: after this long the bot asks "has it stopped?", and
# "⏳ Still ongoing" extends the episode by the same amount. 0 = never ask.
EPISODE_WINDOW_MIN=30
# How many minutes of silence mean "no end time". Defaults to two windows:
# the question was asked and went unanswered.
# STALE_AFTER_MIN=60
# How long after an episode ends plain text/numbers still attach to it
RECENT_EPISODE_MIN=180
