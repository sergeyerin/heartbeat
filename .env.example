# === Telegram ===
# Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# === Language ===
# Used when the Telegram profile language is not ru/en/pt and the user has not
# picked a language with /lang. One of: ru, en, pt.
DEFAULT_LANG=en

# === Time ===
# Zone used to display times (everything is stored in UTC)
TZ=Europe/Moscow

# === Storage ===
# SQLite file. In Docker the data/ directory is mounted as a volume.
DB_PATH=data/heartbeat.db

# === Episode timing ===
# Episode window, minutes: after this long the bot asks "has it stopped?", and
# "⏳ Still ongoing" extends the episode by the same amount. 0 = never ask.
EPISODE_WINDOW_MIN=30
# How many minutes of silence mean "no end time". Defaults to two windows:
# the question was asked and went unanswered.
# STALE_AFTER_MIN=60
# How long after an episode ends plain text/numbers still attach to it
RECENT_EPISODE_MIN=180
